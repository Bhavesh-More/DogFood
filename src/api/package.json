{
  "name": "@dogfood/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "node build.mjs",
    "start": "node dist/server.mjs",
    "migrate": "tsx src/cli.ts migrate",
    "seed": "tsx src/cli.ts seed",
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@dogfood/core": "workspace:*",
    "express": "5.2.1",
    "pg": "8.23.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@dogfood/eslint-config": "workspace:*",
    "@dogfood/typescript-config": "workspace:*",
    "@types/express": "5.0.6",
    "@types/node": "26.4.1",
    "@types/pg": "8.23.1",
    "esbuild": "0.28.2",
    "eslint": "10.9.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
