# Copy to .env for `pnpm dev` (the API on the host). Loaded via node --env-file.
PORT=8001
DATABASE_URL=postgres://postgres@127.0.0.1:5433/dogfood
PUBLIC_URL=http://localhost:5173
APP_SECRET=
SEED_ON_BOOT=true
CHECKER_SESSIONS=true
WEBHOOK_WORKER=true
# Optional AI sidecar for `pnpm dev`. Run `pnpm ai:dev` first, then set true.
AI_ENABLED=false
AI_SERVICE_URL=http://127.0.0.1:8080
