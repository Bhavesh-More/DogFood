# Copy to src/ai/.env when running the sidecar natively (`pnpm ai:dev`).
# Choose a backend by uncommenting EXACTLY ONE preset. All-presets-commented =
# the offline heuristic backend (the service default).
#
# Native model setup (Apple Silicon included):
#   pnpm ai:install:models      # installs torch/transformers/laya on the host
#   pnpm ai:provision:local     # one-time weight download
#   pnpm ai:dev                 # AI_DEVICE=mps on Apple Silicon, else cpu

# --- Device -----------------------------------------------------------------
AI_DEVICE=auto                   # auto-detect: cuda > mps > cpu
# AI_DEVICE=cpu
# AI_DEVICE=cuda                 # Linux + NVIDIA
# AI_DEVICE=mps                  # Apple Silicon GPU — native macOS only

# --- Model provisioning ------------------------------------------------------
# The service runs offline (HF_HUB_OFFLINE=1). Set these to 0 only to download
# weights once via `python -m app.provision`, then set them back to 1.
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

# --- Preset A (default): offline heuristic, no weights -----------------------
# AI_CLASSIFIER_BACKEND=heuristic
# AI_GENERATOR_BACKEND=heuristic

# --- Preset B: Laya classifier + heuristic generator -------------------------
# AI_CLASSIFIER_BACKEND=laya
# AI_CLASSIFIER_MODEL=convaiinnovations/laya
# AI_CLASSIFIER_MODEL=convaiinnovations/laya-typed-decisions
# AI_GENERATOR_BACKEND=heuristic

# --- Preset C: Laya classifier + Gemma 4 generator (Ollama) -------------------
# AI_CLASSIFIER_BACKEND=laya
# AI_CLASSIFIER_MODEL=convaiinnovations/laya
# AI_GENERATOR_BACKEND=ollama
# AI_SUMMARY_MODEL=gemma-4-E2B
# AI_FEEDBACK_MODEL=gemma-4-E4B
# OLLAMA_URL=http://127.0.0.1:11434

# --- Optional -----------------------------------------------------------------
# AI_SERVICE_KEY=
# AI_MAX_BATCH=64
# AI_REQUEST_TIMEOUT_S=60
# AI_VOCAB=devtools,security,civic
