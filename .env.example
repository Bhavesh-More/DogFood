# Copy to .env to override the defaults used by docker-compose.yml.
# Nothing here is required: `docker compose up --build` works as is.

# Host port for the app.
PORT=8000
# Public origin (used for invite links, webhook docs and CSRF origin checks).
PUBLIC_URL=http://localhost:8000
# Database password (the database is never published outside the compose network).
POSTGRES_PASSWORD=dogfood-local-only
# 32+ random characters. Empty = generated on first boot and stored in the database.
APP_SECRET=
# Load fixtures.json into an empty database on boot.
SEED_ON_BOOT=true
# Seed the stable per-role acceptance tokens listed in .dogfood.toml.
CHECKER_SESSIONS=true
# Set both to true when serving over HTTPS behind a reverse proxy.
COOKIE_SECURE=false
TRUST_PROXY=false
# Host port of the dev-only Postgres used by `pnpm dev` (compose profile "dev").
DEV_DB_PORT=5433

# ============================================================================
# Optional AI sidecar (compose profile "ai")
# ----------------------------------------------------------------------------
# Nothing here is required for the normal `docker compose up`.
# To use AI: set AI_ENABLED=true, then start the profile:
#     pnpm services:up      # or: docker compose --profile ai up -d --build
#
# Backends are chosen by uncommenting EXACTLY ONE preset below. Leaving every
# preset commented uses the offline heuristic backend (the service default).
# ============================================================================

AI_ENABLED=false                 # true = use AI features (also start the `ai` profile)
AI_SERVICE_URL=http://ai:8080    # how the app reaches the sidecar on the compose network
AI_SERVICE_KEY=                  # optional shared key; must match the sidecar's
AI_TIMEOUT_MS=5000               # per-call timeout; the app falls back on failure
AI_PORT=8080                     # host port for the sidecar (curl / direct tests)

# --- Device -----------------------------------------------------------------
AI_DEVICE=auto                   # auto-detect: cuda > mps > cpu
# AI_DEVICE=cpu
# AI_DEVICE=cuda                 # Linux + NVIDIA Container Toolkit
# AI_DEVICE=mps                  # Apple Silicon GPU — NATIVE (non-Docker) only

# --- Model provisioning ------------------------------------------------------
# Model presets below set AI_INSTALL_MODELS=1 themselves. After a build with
# extras, run `pnpm ai:provision` ONCE to download weights (the running service
# itself stays offline, so it never downloads during a request).
HF_HUB_OFFLINE=1                 # keep 1 for air-gapped; 0 only while provisioning
TRANSFORMERS_OFFLINE=1

# --- Preset A (default): offline heuristic, no weights -----------------------
# (leave commented; these are the service's built-in defaults)
# AI_CLASSIFIER_BACKEND=heuristic
# AI_GENERATOR_BACKEND=heuristic

# --- Preset B: Laya classifier + heuristic generator -------------------------
# Needs: rebuild + `pnpm ai:provision` (once) — INSTALL_MODELS installs the extras.
# AI_INSTALL_MODELS=1
# AI_CLASSIFIER_BACKEND=laya
# AI_CLASSIFIER_MODEL=convaiinnovations/laya
# AI_CLASSIFIER_MODEL=convaiinnovations/laya-typed-decisions   # fine-tuned, more accurate
# AI_GENERATOR_BACKEND=heuristic

# --- Preset C: Laya classifier + Gemma 4 generator (Ollama) -------------------
# As Preset B, plus a local Ollama serving Gemma 4.
# Needs: rebuild + `ollama pull gemma-4-E2B gemma-4-E4B`.
# AI_INSTALL_MODELS=1
# AI_CLASSIFIER_BACKEND=laya
# AI_CLASSIFIER_MODEL=convaiinnovations/laya
# AI_GENERATOR_BACKEND=ollama
# AI_SUMMARY_MODEL=gemma-4-E2B     # lightest Gemma 4 (summaries)
# AI_FEEDBACK_MODEL=gemma-4-E4B    # effective-4B Gemma 4 (judge feedback)
# OLLAMA_URL=http://host.docker.internal:11434

# --- Optional -----------------------------------------------------------------
# AI_VOCAB=devtools,security,civic   # extra classifier vocabulary
# AI_MAX_BATCH=64
