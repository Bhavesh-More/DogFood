{
  "name": "dogfood-portal",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Self-hostable hackathon submission and judging platform — Dogfood 2026",
  "scripts": {
    "build": "turbo run build",
    "setup": "pnpm env:init && pnpm install && pnpm images:pull && playwright install chromium",
    "env:init": "cp -n .env.example .env; cp -n src/api/.env.example src/api/.env; cp -n src/web/.env.example src/web/.env; true",
    "images:pull": "docker compose --profile dev pull --ignore-buildable && docker pull node:24-alpine",
    "dev": "pnpm dev:db && turbo run dev --ui=tui",
    "dev:db": "docker compose --profile dev up -d --wait devdb",
    "dev:db:stop": "docker compose --profile dev stop devdb",
    "dev:db:reset": "docker compose --profile dev rm -sfv devdb && docker volume rm -f dogfood_devdb-data",
    "dashboard": "docker compose up -d --build --wait && echo 'Dashboard: http://localhost:8000'",
    "dashboard:logs": "docker compose logs -f app",
    "dashboard:down": "docker compose down",
    "dashboard:reset": "docker compose down -v",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types && tsc -p tests",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,css}\"",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "test:acceptance": "python3 acceptance/run.py .dogfood.toml > acceptance-report.txt; cat acceptance-report.txt",
    "db:migrate": "pnpm --filter @dogfood/api migrate",
    "db:seed": "pnpm --filter @dogfood/api seed"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.4.1",
    "@types/pg": "8.23.1",
    "pg": "8.23.0",
    "prettier": "3.9.6",
    "turbo": "^2.11.3",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.12"
  }
}
