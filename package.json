{
  "name": "dogfood-portal",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Self-hostable hackathon submission and judging platform \u2014 Dogfood 2026",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types && tsc -p tests",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,css}\"",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "test:acceptance": "python3 acceptance/run.py .dogfood.toml > acceptance-report.txt; cat acceptance-report.txt",
    "db:migrate": "pnpm --filter @dogfood/api migrate",
    "db:seed": "pnpm --filter @dogfood/api seed"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.4.1",
    "@types/pg": "8.23.1",
    "pg": "8.23.0",
    "prettier": "3.9.6",
    "turbo": "^2.11.3",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.12"
  }
}
